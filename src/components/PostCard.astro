---
interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

const { slug, title, description, pubDate, tags } = Astro.props;
const day = pubDate.toISOString().slice(0, 10);
---

<li class="post-card">
  <time datetime={pubDate.toISOString()}>{day}</time>
  <div class="post-body">
    <a class="post-title-link" href={`/posts/${slug}/`}>{title}</a>
    {description && <p class="post-desc">{description}</p>}
    {tags.length > 0 && (
      <ul class="tag-list">
        {tags.map((tag) => <li class="tag">#{tag}</li>)}
      </ul>
    )}
  </div>
</li>
