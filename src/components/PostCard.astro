---
import TagList from "./TagList.astro";
import { day, readingTime, type Post } from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<li class="post-card">
  <time datetime={pubDate.toISOString()}>{day(pubDate)}</time>
  <div class="post-body">
    <a class="post-title-link" href={`/posts/${post.id}/`}>{title}</a>
    {description && <p class="post-desc">{description}</p>}
    <p class="post-stats">~{readingTime(post.body)} min read</p>
    <TagList tags={tags} />
  </div>
</li>
