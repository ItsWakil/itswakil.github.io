---
interface Props {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
}

const { slug, title, description, pubDate, tags } = Astro.props;

const formattedDate = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<li class="post-card">
  <a class="post-title-link" href={`/posts/${slug}/`}>
    <h2>{title}</h2>
  </a>
  <p class="post-meta">{formattedDate}</p>
  <p class="post-desc">{description}</p>
  {
    tags.length > 0 && (
      <ul class="tag-list">
        {tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )
  }
</li>
