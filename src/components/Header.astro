---
import ThemeToggle from "./ThemeToggle.astro";

const { pathname } = Astro.url;
const path = pathname.replace(/\/$/, "");
const cwd = path === "" ? "~" : `~${path}`;

const links = [
  { href: "/", label: "posts", current: pathname === "/" || pathname.startsWith("/posts/") },
  { href: "/about/", label: "about", current: pathname.startsWith("/about") },
  { href: "/contact/", label: "contact", current: pathname.startsWith("/contact") },
];
---

<header class="site-header">
  <a href="/" class="site-title" aria-label="WakilBlog home">
    <span class="p-host">itswakil</span><span class="p-sep">:</span><span class="p-cwd">{cwd}</span><span class="p-sigil">$</span><span class="cursor" aria-hidden="true"></span>
  </a>
  <nav class="site-nav" aria-label="Main navigation">
    {links.map((link) => (
      <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
    ))}
    <ThemeToggle />
  </nav>
</header>
