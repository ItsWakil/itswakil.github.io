---
import { Image } from "astro:assets";
import TagList from "./TagList.astro";
import CoverFallback from "./CoverFallback.astro";
import { day, readingTime, type Post } from "../lib/posts";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, heroImage, heroAlt } = post.data;
const href = `/posts/${post.id}/`;
---

<article class="featured">
  <a class="featured-media" href={href} tabindex="-1" aria-hidden="true">
    {heroImage ? (
      <Image
        src={heroImage}
        alt=""
        widths={[800, 1200, 1800]}
        sizes="(max-width: 1040px) 100vw, 992px"
        loading="eager"
        fetchpriority="high"
        layout="none"
      />
    ) : <CoverFallback slug={post.id} />}
  </a>
  <div class="featured-body">
    <p class="card-meta"><time datetime={pubDate.toISOString()}>{day(pubDate)}</time> · ~{readingTime(post.body)} min read</p>
    <h2 class="featured-title"><a href={href}>{title}</a></h2>
    {description && <p class="featured-desc">{description}</p>}
    <TagList tags={tags} />
  </div>
</article>
