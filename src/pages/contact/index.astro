---
import BaseLayout from "../../layouts/BaseLayout.astro";

// The Web3Forms access key comes from the WEB3FORMS_KEY repository variable
// (Settings > Secrets and variables > Actions > Variables), passed in by the
// deploy workflow. The key routes messages to your inbox without revealing
// your address; it is safe to appear in the page.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? "";
const ready = accessKey.length > 0;
---

<BaseLayout title="Contact" description="Get in touch.">
  <h1>Contact</h1>
  <div class="page-content">
    <p>
      Have something to say? Fill out the form below. It goes straight to my
      inbox without publishing my email address anywhere on this page.
    </p>

    {!ready && (
      <p class="form-status" data-state="error">
        The contact form isn't connected yet. Check back soon.
      </p>
    )}

    <form id="contact-form" class="contact-form" data-ready={ready ? "true" : "false"} novalidate>
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value="New message from itswakil.github.io" />
      <input type="hidden" name="from_name" value="WakilBlog contact form" />

      <!-- Honeypot: Web3Forms rejects submissions that tick this -->
      <div class="hp-field" aria-hidden="true">
        <label for="botcheck">Leave this unchecked</label>
        <input type="checkbox" id="botcheck" name="botcheck" tabindex="-1" autocomplete="off" />
      </div>

      <div class="field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" autocomplete="name" required />
      </div>

      <div class="field">
        <label for="email">Your email</label>
        <input type="email" id="email" name="email" autocomplete="email" required />
      </div>

      <div class="field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="7" required></textarea>
      </div>

      <button type="submit" disabled={!ready}>Send message</button>
      <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    var form = document.getElementById("contact-form");
    var status = document.getElementById("form-status");
    var button = form.querySelector("button[type=submit]");

    function say(text, state) {
      status.textContent = text;
      status.dataset.state = state || "";
    }

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      if (form.dataset.ready !== "true") return;

      if (form.querySelector("#botcheck").checked) {
        say("Message sent. Thanks!", "success");
        form.reset();
        return;
      }

      if (!form.checkValidity()) {
        say("Fill in your name, a valid email, and a message.", "error");
        form.reportValidity();
        return;
      }

      button.disabled = true;
      say("Sending…");

      try {
        var res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: new FormData(form),
        });
        var result = await res.json();
        if (result.success) {
          say("Message sent. Thanks!", "success");
          form.reset();
        } else {
          say("The message didn't go through. Try again in a moment.", "error");
        }
      } catch (err) {
        say("Couldn't reach the mail service. Check your connection and try again.", "error");
      } finally {
        button.disabled = false;
      }
    });
  })();
</script>
