---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact" description="Get in touch.">
  <h1>Contact</h1>
  <div class="page-content">
    <p>
      Have something to say? Fill out the form below — it goes straight to my
      inbox without publishing my email address anywhere on this page.
    </p>

    <form id="contact-form" class="contact-form" novalidate>
      <!--
        This form posts to Web3Forms (https://web3forms.com), a free service
        built for static sites like this one. It relays submissions to your
        inbox without ever printing your email address in the page's HTML.

        Setup (2 minutes):
        1. Go to https://web3forms.com and enter the email you want
           submissions sent to. You'll get an "access key" back instantly —
           no account required.
        2. Paste that access key below in place of "YOUR-WEB3FORMS-ACCESS-KEY".

        Prefer a different service? Formspree (https://formspree.io) and
        Getform (https://getform.io) work the same way — just swap the
        fetch URL and field names in the <script> below.
      -->
      <input type="hidden" name="access_key" value="YOUR-WEB3FORMS-ACCESS-KEY" />
      <input type="hidden" name="subject" value="New message from Ocean Breeze" />

      <!-- Honeypot: real visitors never see or fill this in; bots often do -->
      <div class="hp-field" aria-hidden="true">
        <label for="hp">Leave this field empty</label>
        <input type="text" id="hp" name="hp" tabindex="-1" autocomplete="off" />
      </div>

      <div>
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required />
      </div>

      <div>
        <label for="email">Your email</label>
        <input type="email" id="email" name="email" required />
      </div>

      <div>
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" required></textarea>
      </div>

      <button type="submit">Send message</button>
      <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    const form = document.getElementById("contact-form");
    const status = document.getElementById("form-status");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Honeypot check — if a bot filled this in, silently pretend success
      if (form.querySelector("#hp").value !== "") {
        status.textContent = "Thanks! Your message has been sent.";
        status.dataset.state = "success";
        form.reset();
        return;
      }

      const accessKey = form.querySelector('[name="access_key"]').value;
      if (accessKey === "YOUR-WEB3FORMS-ACCESS-KEY") {
        status.textContent =
          "Form isn't connected yet — add your Web3Forms access key in contact/index.astro.";
        status.dataset.state = "error";
        return;
      }

      status.textContent = "Sending…";
      status.dataset.state = "";

      const formData = new FormData(form);

      try {
        const res = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { Accept: "application/json" },
          body: formData,
        });
        const result = await res.json();

        if (result.success) {
          status.textContent = "Thanks! Your message has been sent.";
          status.dataset.state = "success";
          form.reset();
        } else {
          status.textContent =
            "Something went wrong. Please try again in a moment.";
          status.dataset.state = "error";
        }
      } catch (err) {
        status.textContent =
          "Something went wrong. Please check your connection and try again.";
        status.dataset.state = "error";
      }
    });
  })();
</script>
