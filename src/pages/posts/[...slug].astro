---
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagList from "../../components/TagList.astro";
import { getPosts, day, readingTime, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage, heroAlt } = post.data;
const { Content } = await render(post);
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  article={{ published: pubDate, modified: updatedDate, tags }}
>
  <article data-pagefind-body>
    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-meta">
        <time datetime={pubDate.toISOString()} data-pagefind-meta="date">{day(pubDate)}</time>
        {updatedDate && <span>, updated {day(updatedDate)}</span>}
        <span> · ~{readingTime(post.body)} min read</span>
      </p>
      <TagList tags={tags} />
    </header>

    {heroImage && (
      <Image
        class="hero"
        src={heroImage}
        alt={heroAlt ?? ""}
        widths={[680, 1360]}
        sizes="(max-width: 720px) 100vw, 680px"
        loading="eager"
        fetchpriority="high"
      />
    )}

    <div class="post-content">
      <Content />
    </div>
  </article>

  {(newer || older) && (
    <nav class="post-nav" aria-label="More posts">
      {older ? (
        <a class="older" href={`/posts/${older.id}/`}><span>&larr; older</span>{older.data.title}</a>
      ) : <span />}
      {newer && (
        <a class="newer" href={`/posts/${newer.id}/`}><span>newer &rarr;</span>{newer.data.title}</a>
      )}
    </nav>
  )}
  <a class="back-link" href="/">&larr; Back to all posts</a>

  <dialog class="lightbox" id="lightbox" aria-label="Image viewer">
    <figure>
      <img id="lb-img" alt="" />
      <figcaption><span id="lb-caption"></span><span id="lb-count" class="lb-count"></span></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-prev" id="lb-prev" aria-label="Previous image">&larr;</button>
    <button type="button" class="lb-btn lb-next" id="lb-next" aria-label="Next image">&rarr;</button>
    <button type="button" class="lb-btn lb-close" id="lb-close" aria-label="Close">×</button>
  </dialog>
</BaseLayout>

<script is:inline>
  (function () {
    // the ## prefix on headings becomes a link to that section
    document.querySelectorAll(".post-content :is(h2, h3)[id]").forEach(function (h) {
      var a = document.createElement("a");
      a.className = "heading-anchor";
      a.href = "#" + h.id;
      a.textContent = "#".repeat(Number(h.tagName[1])) + " ";
      a.setAttribute("aria-label", "Link to this section");
      h.classList.add("has-anchor");
      h.prepend(a);
    });

    // images on back-to-back lines share a <p>; CSS turns those into a grid,
    // this hooks them up to the lightbox
    var lb = document.getElementById("lightbox");
    var lbImg = document.getElementById("lb-img");
    var lbCaption = document.getElementById("lb-caption");
    var lbCount = document.getElementById("lb-count");
    var set = [], at = 0;

    function showAt(i) {
      at = (i + set.length) % set.length;
      var src = set[at];
      lbImg.removeAttribute("srcset");
      if (src.srcset) { lbImg.srcset = src.srcset; lbImg.sizes = "100vw"; }
      lbImg.src = src.currentSrc || src.src;
      lbImg.alt = src.alt;
      lbCaption.textContent = src.alt;
      lbCount.textContent = (at + 1) + " / " + set.length;
    }

    document.querySelectorAll(".post-content p").forEach(function (p) {
      var imgs = Array.prototype.slice.call(p.querySelectorAll(":scope > img"));
      if (imgs.length < 2) return;
      p.classList.add("gallery");
      imgs.forEach(function (img, i) {
        img.tabIndex = 0;
        img.setAttribute("role", "button");
        function open() { set = imgs; showAt(i); lb.showModal(); }
        img.addEventListener("click", open);
        img.addEventListener("keydown", function (e) {
          if (e.key === "Enter" || e.key === " ") { e.preventDefault(); open(); }
        });
      });
    });

    if (lb) {
      document.getElementById("lb-prev").addEventListener("click", function () { showAt(at - 1); });
      document.getElementById("lb-next").addEventListener("click", function () { showAt(at + 1); });
      document.getElementById("lb-close").addEventListener("click", function () { lb.close(); });
      lb.addEventListener("keydown", function (e) {
        if (e.key === "ArrowLeft") showAt(at - 1);
        if (e.key === "ArrowRight") showAt(at + 1);
      });
      // a click on the dark backdrop closes it
      lb.addEventListener("click", function (e) { if (e.target === lb) lb.close(); });
    }

    document.querySelectorAll(".post-content pre").forEach(function (pre) {
      var wrap = document.createElement("div");
      wrap.className = "code-block";
      pre.parentNode.insertBefore(wrap, pre);
      wrap.appendChild(pre);

      var btn = document.createElement("button");
      btn.type = "button";
      btn.className = "copy-btn";
      btn.textContent = "copy";
      btn.addEventListener("click", function () {
        var code = pre.querySelector("code") || pre;
        navigator.clipboard.writeText(code.innerText).then(
          function () { btn.textContent = "copied"; },
          function () { btn.textContent = "failed"; }
        );
        setTimeout(function () { btn.textContent = "copy"; }, 1500);
      });
      wrap.appendChild(btn);
    });
  })();
</script>
