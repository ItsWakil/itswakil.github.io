---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
---

<BaseLayout title="WakilBlog" description="A quirky little corner of the internet.">
  <div class="intro">
    <h1 class="intro-flag"><span role="img" aria-label="Pirate flag">🏴‍☠️</span></h1>
    <p>Thoughts, tech, pens, tattoos, cats, books, whatever.</p>
  </div>

  <p class="cmd"><span class="sigil" aria-hidden="true">$</span>ls -t ~/posts</p>
  <ul class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </ul>
</BaseLayout>
